generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


// ============================================================
// USER TABLE
// ============================================================
// Stores user account, authentication, profile, account status,
// and KYC information. One user can have multiple
// refresh-token sessions (for different devices/logins).
// ============================================================

model User {
  id             String        @id @default(uuid()) @db.Uuid
  email          String        @unique @db.VarChar(255)
  password_hash  String        @db.VarChar(255)
  full_name      String        @db.VarChar(150)
  display_name   String        @db.VarChar(50)
  account_status AccountStatus @default(ACTIVE)
  account_type AccountType?
  phone          String?       @db.VarChar(20)
  avatar_url     String?       @db.VarChar(500)
  kyc_status     KycStatus     @default(NOT_STARTED)
  last_login_at  DateTime?
  created_at     DateTime      @default(now())
  updated_at     DateTime      @updatedAt
  deleted_at     DateTime?

  refresh_tokens RefreshToken[]
  products       Product[]
  seller_auctions Auction[] @relation("SellerAuctions")
  won_auctions    Auction[] @relation("WonAuctions")
  placed_bids     Bid[]     @relation("PlacedBids")

  @@index([account_status])
  @@index([created_at])
}


// ============================================================
// REFRESH TOKEN TABLE
// ============================================================
// Stores refresh-token sessions for users. Only the hashed
// refresh token is stored in the database. Each login/device
// creates a separate refresh-token record.
// ============================================================

model RefreshToken {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  token_hash String   @unique @db.VarChar(64)
  expires_at DateTime
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
}

// ============================================================
// CATEGORY TABLE
// ============================================================
// Stores product categories and their marketplace commission
// configuration.
// ============================================================

model Category {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   @db.VarChar(100)
  slug            String   @unique @db.VarChar(100)
  display_order   Int
  commission_rate Decimal  @db.Decimal(5, 2)
  image_url       String?  @db.VarChar(500)

  products Product[]

  @@index([display_order])
}


// ============================================================
// PRODUCT TABLE
// ============================================================
// Stores product information, seller ownership, category,
// specifications, condition, and product images.
// ============================================================

model Product {
  id             String          @id @default(uuid()) @db.Uuid
  seller_id      String          @db.Uuid
  title          String          @db.VarChar(200)
  description    String?         @db.Text
  detailed_specs Json?
  category_id    String          @db.Uuid
  condition      ProductCondition
  images         Json

  created_at     DateTime        @default(now())
  updated_at     DateTime        @updatedAt

  seller   User     @relation(fields: [seller_id], references: [id])
  category Category @relation(fields: [category_id], references: [id])
  auction  Auction?

  @@index([seller_id])
  @@index([category_id])
  @@index([created_at])
}

// ============================================================
// AUCTION TABLE
// ============================================================
// Stores a seller's auction configuration and its final result.
// Each product may be registered in exactly one auction.
// ============================================================

model Auction {
  id                String        @id @default(uuid()) @db.Uuid
  product_id        String        @unique @db.Uuid
  seller_id         String        @db.Uuid
  starting_price    Decimal       @db.Decimal(12, 2)
  current_bid       Decimal       @db.Decimal(12, 2)
  min_bid_increment Decimal       @default(1) @db.Decimal(12, 2)
  start_time        DateTime
  end_time          DateTime
  status            AuctionStatus @default(SCHEDULED)
  winner_id         String?       @db.Uuid
  created_at        DateTime      @default(now())
  updated_at        DateTime      @updatedAt

  product Product @relation(fields: [product_id], references: [id])
  seller  User    @relation("SellerAuctions", fields: [seller_id], references: [id])
  winner  User?   @relation("WonAuctions", fields: [winner_id], references: [id])
  bids    Bid[]

  @@index([seller_id])
  @@index([winner_id])
  @@index([status, start_time])
  @@index([status, end_time])
}

// ============================================================
// BID TABLE
// ============================================================
// Retains every successful bid so bidder and auction histories
// can be queried after the auction ends.
// ============================================================

model Bid {
  id         String   @id @default(uuid()) @db.Uuid
  auction_id String   @db.Uuid
  bidder_id  String   @db.Uuid
  amount     Decimal  @db.Decimal(12, 2)
  placed_at  DateTime @default(now())

  auction Auction @relation(fields: [auction_id], references: [id], onDelete: Cascade)
  bidder  User    @relation("PlacedBids", fields: [bidder_id], references: [id])

  @@index([auction_id, placed_at])
  @@index([bidder_id, auction_id, placed_at])
}


// ============================================================
// PRODUCT CONDITION
// ============================================================

enum ProductCondition {
  NEW
  USED
  REFURBISHED
}

// ============================================================
// ACCOUNT STATUS
// ============================================================

enum AccountStatus {
  ACTIVE
  SUSPENDED
  BANNED
}


// ============================================================
// KYC STATUS
// ============================================================

enum KycStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  REJECTED
}

enum AccountType {
  BIDDER
  SELLER
}

// ============================================================
// AUCTION STATUS
// ============================================================

enum AuctionStatus {
  SCHEDULED
  ACTIVE
  ENDED
  UNSOLD
  CANCELLED
}