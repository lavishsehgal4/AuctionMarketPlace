generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


// ============================================================
// USER TABLE
// ============================================================
// Stores user account, authentication, profile, account status,
// and KYC information. One user can have multiple
// refresh-token sessions (for different devices/logins).
// ============================================================

model User {
  id             String        @id @default(uuid()) @db.Uuid
  email          String        @unique @db.VarChar(255)
  password_hash  String        @db.VarChar(255)
  full_name      String        @db.VarChar(150)
  display_name   String        @db.VarChar(50)
  account_status AccountStatus @default(ACTIVE)
  account_type AccountType?
  phone          String?       @db.VarChar(20)
  avatar_url     String?       @db.VarChar(500)
  kyc_status     KycStatus     @default(NOT_STARTED)
  last_login_at  DateTime?
  created_at     DateTime      @default(now())
  updated_at     DateTime      @updatedAt
  deleted_at     DateTime?

  refresh_tokens RefreshToken[]
  products       Product[]
  seller_auctions Auction[] @relation("SellerAuctions")
  won_auctions    Auction[] @relation("WonAuctions")
  placed_bids     Bid[]     @relation("PlacedBids")
  seller_profile  SellerProfile?
  written_seller_reviews SellerReview[] @relation("ReviewAuthor")
  received_seller_reviews SellerReview[] @relation("ReviewedSeller")

  @@index([account_status])
  @@index([created_at])
}


// ============================================================
// REFRESH TOKEN TABLE
// ============================================================
// Stores refresh-token sessions for users. Only the hashed
// refresh token is stored in the database. Each login/device
// creates a separate refresh-token record.
// ============================================================

model RefreshToken {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  token_hash String   @unique @db.VarChar(64)
  expires_at DateTime
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
}

// ============================================================
// CATEGORY TABLE
// ============================================================
// Stores product categories and their marketplace commission
// configuration.
// ============================================================

model Category {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   @db.VarChar(100)
  slug            String   @unique @db.VarChar(100)
  display_order   Int
  commission_rate Decimal  @db.Decimal(5, 2)
  image_url       String?  @db.VarChar(500)

  products Product[]

  @@index([display_order])
}


// ============================================================
// PRODUCT TABLE
// ============================================================
// Stores product information, seller ownership, category,
// specifications, condition, and product images.
// ============================================================

model Product {
  id             String          @id @default(uuid()) @db.Uuid
  seller_id      String          @db.Uuid
  title          String          @db.VarChar(200)
  description    String?         @db.Text
  detailed_specs Json?
  category_id    String          @db.Uuid
  condition      ProductCondition
  primary_image  String          @db.VarChar(500)
  additional_images Json          @default("[]")

  created_at     DateTime        @default(now())
  updated_at     DateTime        @updatedAt

  seller   User     @relation(fields: [seller_id], references: [id])
  category Category @relation(fields: [category_id], references: [id])
  auctions Auction[]

  @@index([seller_id])
  @@index([category_id])
  @@index([created_at])
}

// ============================================================
// AUCTION TABLE
// ============================================================
// Stores a seller's auction configuration and its final result.
// A product can be relisted after its prior auction reaches a terminal state.
// ============================================================

model Auction {
  id                String        @id @default(uuid()) @db.Uuid
  product_id        String        @db.Uuid
  seller_id         String        @db.Uuid
  starting_price    Decimal       @db.Decimal(12, 2)
  highest_bid_id    String?       @unique @db.Uuid
  bid_count         Int           @default(0)
  min_bid_increment Decimal       @default(1) @db.Decimal(12, 2)
  start_time        DateTime
  end_time          DateTime
  status            AuctionStatus @default(SCHEDULED)
  winner_id         String?       @db.Uuid
  created_at        DateTime      @default(now())
  updated_at        DateTime      @updatedAt

  product Product @relation(fields: [product_id], references: [id])
  seller  User    @relation("SellerAuctions", fields: [seller_id], references: [id])
  winner  User?   @relation("WonAuctions", fields: [winner_id], references: [id])
  highest_bid Bid? @relation("AuctionHighestBid", fields: [highest_bid_id], references: [id], onDelete: SetNull)
  bids        Bid[] @relation("AuctionBids")
  seller_review SellerReview?

  @@index([seller_id])
  @@index([product_id, status])
  @@index([winner_id])
  @@index([status, start_time])
  @@index([status, end_time])
}

// ============================================================
// SELLER PROFILE TABLE
// ============================================================
// Stores public, seller-specific information separately from
// account credentials and identity data.
// ============================================================

model SellerProfile {
  id             String   @id @default(uuid()) @db.Uuid
  seller_id      String   @unique @db.Uuid
  short_bio      String?  @db.VarChar(150)
  bio            String?  @db.Text
  banner_url     String?  @db.VarChar(500)
  website_url    String?  @db.VarChar(500)
  rating_average Decimal  @default(0) @db.Decimal(3, 2)
  rating_count   Int      @default(0)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  seller User @relation(fields: [seller_id], references: [id], onDelete: Cascade)

  @@index([rating_average, rating_count])
}

// ============================================================
// SELLER REVIEW TABLE
// ============================================================
// One winning bidder can review the seller once per completed
// auction. Aggregate rating is derived from these records.
// ============================================================

model SellerReview {
  id          String   @id @default(uuid()) @db.Uuid
  seller_id   String   @db.Uuid
  reviewer_id String   @db.Uuid
  auction_id  String   @unique @db.Uuid
  rating      Int
  comment     String?  @db.Text
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  seller   User    @relation("ReviewedSeller", fields: [seller_id], references: [id], onDelete: Cascade)
  reviewer User    @relation("ReviewAuthor", fields: [reviewer_id], references: [id], onDelete: Cascade)
  auction  Auction @relation(fields: [auction_id], references: [id], onDelete: Cascade)

  @@index([seller_id, created_at])
  @@index([reviewer_id, created_at])
}

// ============================================================
// BID TABLE
// ============================================================
// Retains every successful bid so bidder and auction histories
// can be queried after the auction ends.
// ============================================================

model Bid {
  id         String   @id @default(uuid()) @db.Uuid
  auction_id String   @db.Uuid
  bidder_id  String   @db.Uuid
  amount     Decimal  @db.Decimal(12, 2)
  placed_at  DateTime @default(now())

  auction             Auction  @relation("AuctionBids", fields: [auction_id], references: [id], onDelete: Cascade)
  bidder              User     @relation("PlacedBids", fields: [bidder_id], references: [id])
  highest_for_auction Auction? @relation("AuctionHighestBid")

  @@index([auction_id, placed_at])
  @@index([auction_id, amount])
  @@index([bidder_id, auction_id, placed_at])
}


// ============================================================
// PRODUCT CONDITION
// ============================================================

enum ProductCondition {
  NEW
  USED
  REFURBISHED
}

// ============================================================
// ACCOUNT STATUS
// ============================================================

enum AccountStatus {
  ACTIVE
  SUSPENDED
  BANNED
}


// ============================================================
// KYC STATUS
// ============================================================

enum KycStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  REJECTED
}

enum AccountType {
  BIDDER
  SELLER
}

// ============================================================
// AUCTION STATUS
// ============================================================

enum AuctionStatus {
  SCHEDULED
  ACTIVE
  ENDED
  UNSOLD
  CANCELLED
}